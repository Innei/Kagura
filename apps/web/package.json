{
  "name": "@kagura/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run codegen && vite build",
    "codegen": "panda codegen",
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "KAGURA_WEB_MOCK_API=true vite --host 127.0.0.1 --open /reviews/mock-review",
    "prepare": "npm run codegen",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run codegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.3.6",
    "@pierre/trees": "1.0.0-beta.4",
    "@vitejs/plugin-react": "^6.1.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "code-inspector-plugin": "^1.6.6"
  }
}
