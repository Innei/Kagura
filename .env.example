NODE_ENV=development
PORT=3000

# Optional non-secret runtime configuration file.
# Values in .env override config.json.
APP_CONFIG_PATH=./config.json
AGENT_DEFAULT_PROVIDER=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APP_ID=
SLACK_CONFIG_TOKEN=
SLACK_CONFIG_REFRESH_TOKEN=
SLACK_CONFIG_TOKEN_STORE_PATH=./data/slack-config-tokens.json
SLACK_SIGNING_SECRET=
SLACK_REACTION_NAME=eyes

CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_ENABLE_SKILLS=false

CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_CLI_SANDBOX=

# Optional Claude Code-compatible backend overrides.
# These are consumed directly by the Claude Code runtime rather than by this app.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

LOG_LEVEL=info
LOG_TO_FILE=false
LOG_DIR=./logs

# Docker Compose helper: absolute host path containing candidate repositories.
# Example: /Users/yourname/git
HOST_REPO_ROOT=

# Optional Linux bind-mount compatibility for host-owned repositories.
# Set to your host uid:gid, for example from `id -u` and `id -g`.
# Leave blank to use the image's default non-root `app` user.
HOST_UID_GID=

# Local Node usage example:
# REPO_ROOT_DIR=~/git
#
# Docker Compose usage:
# REPO_ROOT_DIR=/workspace
REPO_ROOT_DIR=~/git
REPO_SCAN_DEPTH=2
# Defaults to "$REPO_ROOT_DIR/kagura-worktrees" when unset.
WORKTREE_ROOT_DIR=

KAGURA_THREAD_TITLE_ENABLED=true
KAGURA_THREAD_TITLE_API_KEY=
KAGURA_THREAD_TITLE_BASE_URL=https://api.openai.com/v1
KAGURA_THREAD_TITLE_MODEL=gpt-5.6-luna
KAGURA_THREAD_TITLE_TIMEOUT_MS=8000
KAGURA_THREAD_TITLE_MAX_TOKENS=80

KAGURA_REVIEW_PANEL_ENABLED=false
KAGURA_REVIEW_PANEL_HOST=127.0.0.1
KAGURA_REVIEW_PANEL_PORT=3077
KAGURA_REVIEW_PANEL_BASE_URL=http://127.0.0.1:3077
KAGURA_REVIEW_PANEL_ASSETS_DIR=./apps/web/dist

SESSION_DB_PATH=./data/sessions.db
A2A_COORDINATOR_DB_PATH=./data/a2a-coordinator.db
A2A_OUTPUT_MODE=verbose
A2A_DIAGNOSTICS_DIR=./data/a2a-diagnostics
